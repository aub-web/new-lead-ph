# Postgres connection string (Neon — use the pooled "-pooler" host).
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&channel_binding=require"

# Direct (non-pooled — no "-pooler" in the host) connection string, used only
# for `prisma migrate deploy`/`migrate dev`. The pooled endpoint above doesn't
# support the session-level advisory lock migrations take. Falls back to
# DATABASE_URL if unset.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Shared secret the cron trigger (netlify/functions/sync-leads.ts) sends as
# `Authorization: Bearer <value>` when it calls /api/cron/sync. Generate with
# `openssl rand -hex 24`.
CRON_SECRET="replace-with-a-long-random-value"

# --- Google Sheets (service account, read-only) ---
# From Google Cloud Console: IAM & Admin > Service Accounts > (your account)
# > Keys > Add key > JSON. Share the lead sheet with this service account's
# email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL="ph-lead-notifier@your-project.iam.gserviceaccount.com"
# Paste the JSON key's "private_key" value as-is (with literal \n sequences,
# quoted) — do not reformat it.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID="1XjVc5buQ_FW_XObI4dSBWxN3HxTxSoWEpm4gXpCDnMI"
# Tab name and column range to read, e.g. "Sheet1!A:Z" or "Leads!A1:M".
GOOGLE_SHEET_RANGE="Sheet1!A:Z"

# Exact header text of the column that holds country/region (optional — if
# unset, the app guesses by matching a header containing "country", "region",
# or "market").
PH_COUNTRY_COLUMN="Country"
# Comma-separated values (case-insensitive, substring match) that count as
# Philippines.
PH_MATCH_VALUES="philippines,ph,phl,phil"

# --- Slack ---
# Create at https://api.slack.com/apps > your app > Incoming Webhooks.
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="New Lead PH <onboarding@resend.dev>"
# Comma-separated recipient list.
EMAIL_RECIPIENTS="you@atlascapture.io"
