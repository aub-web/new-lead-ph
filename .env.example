# Postgres connection string (Neon — use the pooled "-pooler" host).
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&channel_binding=require"

# Direct (non-pooled — no "-pooler" in the host) connection string, used only
# for `prisma migrate deploy`/`migrate dev`. The pooled endpoint above doesn't
# support the session-level advisory lock migrations take. Falls back to
# DATABASE_URL if unset.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Shared secret the cron trigger (netlify/functions/sync-leads.ts) sends as
# `Authorization: Bearer <value>` when it calls /api/cron/sync. Generate with
# `openssl rand -hex 24`.
CRON_SECRET="replace-with-a-long-random-value"

# Secret used to sign the /admin session cookie. Generate with
# `openssl rand -hex 32`.
SESSION_SECRET="replace-with-a-long-random-value"

# The only people allowed to sign in to /admin. Comma-separated. (Who gets
# Slack-notified is controlled separately by SLACK_WEBHOOK_URL below — add
# the same people to that channel.)
ALLOWED_EMAILS="aubrey@atlascapture.io,kbinas@atlascapture.io,dpalma@atlascapture.io,verly@atlascapture.io,joaquin@atlascapture.io"

# --- Google Sheets (OAuth, read-only) ---
# From Google Cloud Console: APIs & Services > Credentials > Create
# Credentials > OAuth client ID > Web application. Add
# <your-deploy-url>/api/admin/google-oauth/callback as an authorized
# redirect URI.
GOOGLE_OAUTH_CLIENT_ID="<from Google Cloud Console, ends in .apps.googleusercontent.com>"
GOOGLE_OAUTH_CLIENT_SECRET="<from Google Cloud Console>"
# Not set by hand — leave blank, deploy, then (signed in to /admin) visit
# /api/admin/google-oauth once. Sign in with a Google account that already
# has Viewer access to the lead sheet; the callback page shows a refresh
# token to paste in here.
GOOGLE_OAUTH_REFRESH_TOKEN=""

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID="1XjVc5buQ_FW_XObI4dSBWxN3HxTxSoWEpm4gXpCDnMI"
# This sheet has no fixed "leads" tab — the team archives old data into
# dated tabs (e.g. "Before Aug 27") rather than one permanent tab. Every tab
# is watched, each with its own independent progress cursor; this is just
# the column range applied within each one.
GOOGLE_SHEET_COLUMN_RANGE="A:Z"

# Exact header text of the column that holds country/region (optional — if
# unset, the app guesses by matching a header containing "country", "region",
# or "market"; this sheet also has a "phoneCountry" column that guess could
# match instead, so it's set explicitly here).
PH_COUNTRY_COLUMN="country"
# Comma-separated values (case-insensitive, substring match) that count as
# Philippines.
PH_MATCH_VALUES="philippines,ph,phl,phil,phile"

# --- Slack ---
# From https://api.slack.com/apps > your app.
# "Sign in with Slack" (Basic Information page, or the OAuth & Permissions
# page's "Sign In with Slack" section) — used to log in to /admin.
SLACK_CLIENT_ID="0000000000.0000000000"
SLACK_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Incoming Webhook for the #new-lead-ph channel — Slack app > Incoming
# Webhooks > Add New Webhook to Workspace > pick #new-lead-ph. Every message
# pings @channel, so add everyone who should be notified to that channel.
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="New Lead PH <onboarding@resend.dev>"
# Comma-separated recipient list.
EMAIL_RECIPIENTS="you@atlascapture.io"
