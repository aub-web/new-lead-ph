// Prisma schema for New Lead PH — watches the global leads Google Sheet and
// notifies the Philippines team about new Philippines-tagged rows.
// Runs on Postgres (Neon) via the pg driver adapter — see src/lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tracks sync progress per sheet tab — every tab in the spreadsheet is
// watched (the team archives old data into dated tabs rather than one
// permanent "leads" tab, so a single global cursor isn't enough). The first
// time a tab is seen, src/lib/sync.ts seeds lastRowNumber to that tab's
// current row count instead of 1, so pre-existing historical rows (e.g. 100+
// already-processed leads in an archive tab) don't all fire as "new" at
// once — only rows added after that point count as new.
model TabSyncState {
  tabTitle      String   @id
  lastRowNumber Int
  lastSyncedAt  DateTime @default(now())
  lastError     String?
}

// One row from the sheet that matched the Philippines filter. Uniqueness is
// (tabTitle, rowNumber) rather than just rowNumber, since row numbers reset
// to 1 in every new tab the team rotates to — without tabTitle, "row 2" in a
// freshly rotated tab would collide with a since-archived "row 2" from the
// old tab and never get notified.
model Lead {
  id        String @id @default(cuid())
  tabTitle  String
  rowNumber Int

  // Best-effort extracted fields for display; the full row is kept in `data`
  // since sheet columns vary and this app shouldn't need a migration every
  // time the global team adds a field.
  name    String?
  contact String?
  country String?
  data    Json

  slackNotifiedAt DateTime?
  emailNotifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([tabTitle, rowNumber])
  @@index([createdAt])
}
