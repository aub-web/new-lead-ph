// Prisma schema for New Lead PH — watches the global leads Google Sheet and
// notifies the Philippines team about new Philippines-tagged rows.
// Runs on Postgres (Neon) via the pg driver adapter — see src/lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tracks how far into the sheet we've synced. A single row (id "singleton"),
// keyed on the sheet's row number rather than content, since leads are
// appended to the bottom of the sheet by the global team.
//
// activeTabTitle tracks which tab lastRowNumber refers to — the team
// periodically rotates to a new "<date> - Current" tab and archives the old
// one (e.g. "Before Aug 27"). When the resolved current tab's title changes,
// src/lib/sync.ts resets lastRowNumber back to the header row instead of
// carrying over a row count that belonged to a different, now-archived tab.
model SyncState {
  id             String   @id @default("singleton")
  activeTabTitle String?
  lastRowNumber  Int      @default(1)
  lastSyncedAt   DateTime @default(now())
  lastError      String?
}

// One row from the sheet that matched the Philippines filter. Uniqueness is
// (tabTitle, rowNumber) rather than just rowNumber, since row numbers reset
// to 1 in every new tab the team rotates to — without tabTitle, "row 2" in a
// freshly rotated tab would collide with a since-archived "row 2" from the
// old tab and never get notified.
model Lead {
  id        String @id @default(cuid())
  tabTitle  String
  rowNumber Int

  // Best-effort extracted fields for display; the full row is kept in `data`
  // since sheet columns vary and this app shouldn't need a migration every
  // time the global team adds a field.
  name    String?
  contact String?
  country String?
  data    Json

  slackNotifiedAt DateTime?
  emailNotifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([tabTitle, rowNumber])
  @@index([createdAt])
}
